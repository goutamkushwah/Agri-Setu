# Copy this file to .env and fill in real values locally (never commit .env)
# cp .env.example .env

NODE_ENV=development
PORT=5000

# Database
DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agri_setu_dev
DB_NAME_TEST=agri_setu_test
DB_USER=postgres
DB_PASSWORD=your-database-password-here

# JWT — use long random strings in production (openssl rand -base64 48)
JWT_SECRET=change-me-use-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-use-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# Frontend (Vite default port)
FRONTEND_URL=http://localhost:8080

# Admin seed only — npx knex seed:run
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-admin-password-here

# Optional: OpenAI for AI chatbot (leave empty for built-in FAQ bot)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@agri-setu.com

# Optional: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
